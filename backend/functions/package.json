{
  "name": "call4li-functions",
  "description": "Call4li Firebase Cloud Functions backend",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.3.0",
    "firebase-functions": "^6.3.2",
    "twilio": "^5.5.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "firebase-functions-test": "^3.4.0",
    "typescript": "^5.8.2"
  },
  "private": true
}
