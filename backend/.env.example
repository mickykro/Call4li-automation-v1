# Firebase Admin SDK (auto-injected in Cloud Functions, only needed for local dev)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+972xxxxxxxxx
TWILIO_TEST_NUMBER=+972xxxxxxxxx

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Admin secret (used to protect /admin/* endpoints)
ADMIN_SECRET=your_admin_secret_here

# App base URL (for onboarding links)
APP_BASE_URL=https://call4li.com
