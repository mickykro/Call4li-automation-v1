# Server
PORT=3001

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+972500000000
TWILIO_TEST_NUMBER=+972500000001

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# App
APP_BASE_URL=https://call4li.com
ADMIN_SECRET=your_admin_secret
CRON_SECRET=your_cron_secret

# Firebase — paste the JSON content of your service account key
# OR set GOOGLE_APPLICATION_CREDENTIALS to the file path (local dev)
FIREBASE_PROJECT_ID=call4li
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
